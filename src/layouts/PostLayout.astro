---
import BaseLayout from './BaseLayout.astro';
import type { PathNav } from '../lib/paths';

interface Props {
  title: string;
  date: Date;
  description: string;
  subtitle?: string;
  tags?: string[];
  coverImage?: string;
  readingMinutes?: number;
  /** Where this turn sits in its path. Absent only for posts no path has claimed yet. */
  pathNav?: PathNav;
}

const { title, date, description, subtitle, tags = [], coverImage, readingMinutes, pathNav } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} ogImage={coverImage} ogType="article">
  <Fragment slot="head">
    <meta property="article:author" content="Troy Sybert" />
    <meta property="article:published_time" content={date.toISOString()} />
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Back to the path, not to an archive -->
    {pathNav ? (
      <a href={pathNav.href} class="kicker kicker-muted no-underline hover:text-vor-gold-dark">
        &larr; Path {pathNav.number} · {pathNav.title}
      </a>
    ) : (
      <a href="/paths" class="kicker kicker-muted no-underline hover:text-vor-gold-dark">
        &larr; All paths
      </a>
    )}

    <header class="mt-8 mb-10">
      {pathNav && (
        <p class="kicker">Path {pathNav.number} · Week {pathNav.week} of {pathNav.total}</p>
      )}
      <h1 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-heading font-semibold text-vor-charcoal leading-tight">
        {title}
      </h1>
      {(subtitle || description) && (
        <p class="mt-5 text-lg leading-relaxed text-vor-charcoal-light" style="text-wrap:pretty">
          {subtitle || description}
        </p>
      )}
      <div class="mt-6 flex items-center gap-3 flex-wrap">
        <span class="kicker kicker-muted">Troy Sybert</span>
        <span class="text-vor-sand">&middot;</span>
        <time class="kicker kicker-muted">{formattedDate}</time>
        {readingMinutes && (
          <>
            <span class="text-vor-sand">&middot;</span>
            <span class="kicker kicker-muted">{readingMinutes} min read</span>
          </>
        )}
      </div>
    </header>

    {coverImage && (
      <div class="plate mb-12">
        <img src={coverImage} alt={title} style="aspect-ratio:16/9;object-fit:cover" />
      </div>
    )}

    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    <!-- Next turn in the path -->
    {pathNav && (
      <nav class="hairline mt-16 pt-10" aria-label={'Path ' + pathNav.number + ' navigation'}>
        {pathNav.next ? (
          <a href={pathNav.next.href} class="group block no-underline">
            <span class="kicker">Next turn &mdash; week {pathNav.next.week} of {pathNav.total}</span>
            <span class="mt-3 block text-2xl sm:text-3xl font-heading font-semibold leading-tight text-vor-charcoal group-hover:text-vor-gold-dark transition-colors">
              {pathNav.next.title}
            </span>
          </a>
        ) : (
          <div>
            <span class="kicker">That is the end of Path {pathNav.number}</span>
            <p class="mt-3 text-lg leading-relaxed text-vor-charcoal-light measure" style="text-wrap:pretty">
              Walking it once does not finish it. Sit with the whole path for a week
              before you go looking for the next thing.
            </p>
            <div class="mt-7 flex flex-wrap gap-4">
              <a href={pathNav.href} class="btn-quiet">Back to Path {pathNav.number}</a>
              <a href="/paths" class="btn-line">Choose another path</a>
            </div>
          </div>
        )}

        {pathNav.alsoIn.length > 0 && (
          <p class="mt-10 text-sm text-vor-muted">
            This turn also does work in{' '}
            {pathNav.alsoIn.map((p, i) => (
              <>
                {i > 0 && ', '}
                <a href={p.href}>Path {p.number} &mdash; {p.title}</a>
              </>
            ))}.
          </p>
        )}
      </nav>
    )}

    {tags.length > 0 && (
      <div class="hairline mt-14 pt-8 flex flex-wrap gap-2 items-center">
        <span class="kicker kicker-muted mr-2">Tagged</span>
        {tags.map((tag) => (
          <a
            href={'/blog/tags/' + tag.toLowerCase()}
            class="text-xs font-heading px-2.5 py-1 border border-vor-sand text-vor-charcoal-light hover:border-vor-gold-dark hover:text-vor-gold-dark no-underline transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

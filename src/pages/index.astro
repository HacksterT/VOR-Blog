---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathCard from '../components/PathCard.astro';
import { getResolvedPaths, getCurrentTurn } from '../lib/paths';

const paths = await getResolvedPaths();
const current = await getCurrentTurn();
---

<BaseLayout
  title="Voice of Repentance"
  description="Four paths through the things that actually wear a believer down, walked one week at a time. Nothing here costs money and nothing here is for sale."
>
  <!-- Hero: the one full-bleed image on the site -->
  <section class="relative border-b border-vor-sand">
    <img
      src="/images/site/wheat-field-main-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      style="filter:sepia(0.1) saturate(0.9)"
    />
    <div class="absolute inset-0 bg-vor-charcoal/55"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28 md:py-40">
      <div class="max-w-3xl">
        <span class="kicker text-vor-gold">Voice of Repentance</span>
        <h1 class="mt-5 text-4xl sm:text-5xl md:text-6xl font-heading font-semibold leading-[1.05] text-white">
          Repentance is a direction, not a performance.
        </h1>
        <p class="mt-6 text-lg sm:text-xl leading-relaxed text-white/85 measure" style="text-wrap:pretty">
          This is not an archive of old posts. It is four paths through the things that
          actually wear a believer down &mdash; each one three or four weeks long, each
          one written to be walked rather than skimmed.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/start-here" class="btn-line border-vor-gold text-vor-gold hover:bg-vor-gold hover:text-vor-charcoal">
            Start here
          </a>
          <a href="/walk" class="btn-quiet border-white/40 text-white/90 hover:border-vor-gold hover:text-vor-gold">
            Walk with me
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- This week's turn -->
  {current && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 border-b border-vor-sand">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] items-start">
        <div>
          <span class="kicker">This week&rsquo;s turn</span>
          <p class="kicker kicker-muted mt-3">
            Path {current.path.number} · Week {current.turn.week} of {current.path.weeks} · {current.turn.minutes} min
          </p>
          <h2 class="mt-4 text-3xl sm:text-4xl font-heading font-semibold leading-tight text-vor-charcoal">
            <a href={current.turn.href} class="no-underline text-vor-charcoal hover:text-vor-gold-dark">
              {current.turn.title}
            </a>
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-vor-charcoal-light measure" style="text-wrap:pretty">
            {current.turn.description}
          </p>
          <div class="mt-7 flex flex-wrap gap-4">
            <a href={current.turn.href} class="btn-line">Read it</a>
            <a href={current.path.href} class="btn-quiet">Start this path from week 1</a>
          </div>
        </div>
        {current.turn.coverImage && (
          <a href={current.turn.href} class="plate no-underline">
            <img src={current.turn.coverImage} alt="" loading="lazy" style="aspect-ratio:4/3;object-fit:cover" />
          </a>
        )}
      </div>
    </section>
  )}

  <!-- The four paths -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 border-b border-vor-sand">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="kicker">The paths</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-heading font-semibold text-vor-charcoal">
          Pick the one that sounds like you
        </h2>
      </div>
      <a href="/start-here" class="text-sm font-heading text-vor-gold-dark hover:text-vor-gold no-underline">
        Not sure which &rarr;
      </a>
    </div>

    <div class="mt-12 flex flex-col gap-14">
      {paths.map((path) => <PathCard path={path} />)}
    </div>
  </section>

  <!-- The rhythm -->
  <section class="bg-vor-warm border-b border-vor-sand">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <span class="kicker">The rhythm</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-heading font-semibold text-vor-charcoal">
        Two emails a week, and neither one asks you for anything
      </h2>

      <div class="mt-12 grid gap-10 sm:grid-cols-3">
        <div class="border-t border-vor-gold pt-5">
          <span class="kicker">Wednesday</span>
          <h3 class="mt-2 text-xl font-heading font-semibold text-vor-charcoal">The turn</h3>
          <p class="mt-2 text-base leading-relaxed text-vor-charcoal-light">
            One reading. Ten to fifteen minutes. In order, from week one of the path you chose.
          </p>
        </div>
        <div class="border-t border-vor-gold pt-5">
          <span class="kicker">Sunday</span>
          <h3 class="mt-2 text-xl font-heading font-semibold text-vor-charcoal">The sit</h3>
          <p class="mt-2 text-base leading-relaxed text-vor-charcoal-light">
            A song and one question. Nothing to read. Nothing to do but sit with it.
          </p>
        </div>
        <div class="border-t border-vor-gold pt-5">
          <span class="kicker">Any day</span>
          <h3 class="mt-2 text-xl font-heading font-semibold text-vor-charcoal">Reply</h3>
          <p class="mt-2 text-base leading-relaxed text-vor-charcoal-light">
            Every email comes from me and every reply reaches me. What you write is never quoted or published.
          </p>
        </div>
      </div>

      <div class="hairline mt-14 pt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] items-start">
        <div>
          <h3 class="text-2xl font-heading font-semibold text-vor-charcoal">
            Nothing here costs money and nothing here is for sale
          </h3>
          <p class="mt-3 text-lg leading-relaxed text-vor-charcoal-light measure" style="text-wrap:pretty">
            No donate button, no tip jar, no paid tier, no course, no upsell in the
            email footer. I am saying it plainly because you have been trained to wait
            for the ask. There isn&rsquo;t one.
          </p>
        </div>
        <div class="bg-white border border-vor-sand p-7">
          <span class="kicker">Walk with me</span>
          <p class="mt-3 mb-6 text-base leading-relaxed text-vor-charcoal-light">
            Choose a path and I&rsquo;ll send it to you one week at a time.
          </p>
          <a href="/walk" class="btn-line w-full justify-center">Choose a path</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The book -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 border-b border-vor-sand">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,14rem)_1fr] items-start">
      <a href="/book" class="plate no-underline">
        <img src="/images/book/Cover4.jpg" alt="Journey2Health: The Battle Within" loading="lazy" />
      </a>
      <div>
        <span class="kicker">The book</span>
        <h2 class="mt-3 text-3xl font-heading font-semibold text-vor-charcoal">
          Journey2Health: The Battle Within
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-vor-charcoal-light measure" style="text-wrap:pretty">
          Thirty years of exam rooms, read against Galatians 5. The argument is that
          &ldquo;the flesh&rdquo; is not a metaphor &mdash; that what Paul describes has a
          physiology, and that this changes what you should expect of your own willpower.
        </p>
        <a href="/book" class="btn-line mt-7">About the book</a>
      </div>
    </div>
  </section>

  <!-- Troy -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,12rem)_1fr] items-start">
      <a href="/about" class="plate no-underline">
        <img src="/images/site/Dr__Sybert_photo.jpg" alt="Troy Sybert" loading="lazy" style="aspect-ratio:1/1;object-fit:cover" />
      </a>
      <div>
        <span class="kicker">Who writes this</span>
        <h2 class="mt-3 text-3xl font-heading font-semibold text-vor-charcoal">Troy Sybert</h2>
        <p class="mt-4 text-lg leading-relaxed text-vor-charcoal-light measure" style="text-wrap:pretty">
          I am a physician and a layman, not a licensed counselor and not a pastor.
          What I have is thirty years of watching people try to change, and a long
          argument with my own record of it. That is the whole credential.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/about" class="btn-line">Read more</a>
          <a href="/about#contact" class="btn-quiet">Write to me</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

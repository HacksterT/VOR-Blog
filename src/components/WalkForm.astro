---
import { WALK_OPTIONS } from '../lib/paths';

interface Props {
  /** Preselect a path (used on the path pages). */
  preselect?: string;
  /** Distinguishes multiple forms on one page. */
  formId?: string;
}

const { preselect = 'riding-along', formId = 'walk-form' } = Astro.props;
---

<div>
  <form id={formId} class="flex flex-col gap-5" data-walk-form>
    <div>
      <label class="field-label" for={formId + '-name'}>First name</label>
      <input class="field-input" type="text" id={formId + '-name'} name="name" required autocomplete="given-name" placeholder="What should I call you?" />
    </div>

    <div>
      <label class="field-label" for={formId + '-email'}>Email</label>
      <input class="field-input" type="email" id={formId + '-email'} name="email" required autocomplete="email" placeholder="your@email.com" />
    </div>

    <div>
      <label class="field-label" for={formId + '-path'}>Which walk?</label>
      <select class="field-input" id={formId + '-path'} name="path">
        {WALK_OPTIONS.map((opt) => (
          <option value={opt.value} selected={opt.value === preselect}>{opt.label}</option>
        ))}
      </select>
      <p class="text-xs text-vor-muted mt-2">
        Pick a path and you get that path&rsquo;s turns in order, from week one — not whatever went out that Wednesday.
      </p>
    </div>

    <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="cf-turnstile" data-sitekey="0x4AAAAAADvNCYK6GF56tDw4" data-theme="light"></div>

    <button type="submit" class="btn-line justify-center">Walk with me</button>

    <p class="text-xs text-vor-charcoal-light">
      One email Wednesday, one on Sunday. Reply to any of them and it reaches me.
      You can leave from the bottom of any email.
    </p>
  </form>

  <div id={formId + '-success'} class="hidden py-8">
    <span class="kicker">You&rsquo;re on the walk</span>
    <p class="mt-3 text-lg text-vor-charcoal measure">
      Check your inbox for a short note about the rhythm. If it isn&rsquo;t there in ten minutes, look in spam and drag it out — that teaches your mail client to keep the rest.
    </p>
  </div>

  <div id={formId + '-error'} class="hidden py-4 text-sm text-red-700">
    That didn&rsquo;t go through. Try again, or just email
    <a href="mailto:troy@voiceofrepentance.com" class="underline">troy@voiceofrepentance.com</a> and I&rsquo;ll add you by hand.
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { submitForm } from '../lib/formSubmit';

  document.querySelectorAll('[data-walk-form]').forEach((el) => {
    const form = el as HTMLFormElement;
    const success = document.getElementById(form.id + '-success');
    const error = document.getElementById(form.id + '-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error?.classList.add('hidden');
      const data = new FormData(form);
      try {
        const res = await submitForm(form, {
          name: String(data.get('name') || ''),
          email: String(data.get('email') || ''),
          source: 'walk',
          metadata: { path: String(data.get('path') || 'riding-along') },
        });
        if (res.ok) {
          form.classList.add('hidden');
          success?.classList.remove('hidden');
        } else {
          error?.classList.remove('hidden');
        }
      } catch {
        error?.classList.remove('hidden');
      }
    });
  });
</script>

---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/start-here', label: 'Start Here' },
  { href: '/this-week', label: 'This Week' },
  { href: '/paths', label: 'Paths' },
  { href: '/music', label: 'Music' },
  { href: '/book', label: 'The Book' },
  { href: '/about', label: 'Troy' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="bg-vor-cream/90 backdrop-blur-sm border-b border-vor-sand sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="text-xl font-heading font-semibold text-vor-charcoal hover:text-vor-gold-dark no-underline">
        Voice of Repentance
      </a>

      <div class="hidden md:flex items-center gap-8">
        <ul class="flex items-center gap-7">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', isActive(link.href) ? 'is-active' : '']}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/walk" class="btn-line">Walk with me</a>
      </div>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-vor-charcoal hover:text-vor-gold-dark bg-transparent border-0 cursor-pointer"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-5">
      <ul class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['mobile-link', isActive(link.href) ? 'is-active' : '']}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/walk" class="btn-line w-full mt-4">Walk with me</a>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    padding-bottom: 4px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #4A4A4A;
    transition: color 200ms ease, border-color 200ms ease;
    line-height: 1;
  }
  .nav-link:hover {
    color: #A8863E;
  }
  .nav-link.is-active {
    color: #A8863E;
    border-bottom-color: #C8A45E;
  }

  .mobile-link {
    display: block;
    padding: 0.625rem 0.25rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #4A4A4A;
    border-bottom: 1px solid #E8E0D0;
    transition: color 150ms ease;
  }
  .mobile-link:hover,
  .mobile-link.is-active {
    color: #A8863E;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    icon?.setAttribute('d', expanded ? 'M4 6h16M4 12h16M4 18h16' : 'M6 18L18 6M6 6l12 12');
  });
</script>

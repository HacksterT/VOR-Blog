---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Walk',
    links: [
      { href: '/start-here', label: 'Start here' },
      { href: '/paths', label: 'All paths' },
      { href: '/this-week', label: "This week's turn" },
      { href: '/walk', label: 'Walk with me' },
    ],
  },
  {
    heading: 'Also here',
    links: [
      { href: '/music', label: 'Music' },
      { href: '/book', label: 'The book' },
      { href: '/story', label: 'My story' },
      { href: '/am-i-saved', label: 'Am I saved?' },
    ],
  },
  {
    heading: 'Elsewhere',
    links: [
      { href: '/ai-ministry', label: 'AI in ministry' },
      { href: '/selah', label: 'Selah (in pilot)' },
      { href: '/about', label: 'Write to Troy' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
];
---

<footer class="border-t border-vor-sand bg-vor-warm mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-3">
        <span class="font-heading font-semibold text-lg text-vor-charcoal">Voice of Repentance</span>
        <div class="flex items-center gap-4 mt-1">
          <a
            href="https://www.youtube.com/@VoiceofRepentance"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Voice of Repentance on YouTube"
            class="text-vor-muted hover:text-vor-gold-dark transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/>
              <polygon fill="#F5F0E8" points="9.545,15.568 15.818,12 9.545,8.432"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/voiceofrepentance/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Voice of Repentance on Facebook"
            class="text-vor-muted hover:text-vor-gold-dark transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div class="flex flex-col gap-3">
          <span class="kicker kicker-muted">{col.heading}</span>
          <ul class="flex flex-col gap-2">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm font-heading text-vor-charcoal-light hover:text-vor-gold-dark no-underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hairline mt-12 pt-6">
      <p class="text-xs text-vor-muted">&copy; {year} Troy Sybert · Voice of Repentance</p>
    </div>
  </div>
</footer>

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

/images/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep every branch preview out of the index. The Pages project is `vor-blog`,
# so previews are <branch>.vor-blog.pages.dev -- not voiceofrepentance.pages.dev.
https://:branch.vor-blog.pages.dev/*
  X-Robots-Tag: noindex
